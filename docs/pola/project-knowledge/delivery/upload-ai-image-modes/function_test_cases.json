          "assertions": ["T2I 分别调用 1/3/5 次", "返回 1/3/5 张图片"],
          "expected": "固定档位总数精确",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_fixed_image_modes_generate_exact_total_counts -q"
        },
        {
          "id": "UT-F3-002",
          "target": "app/uploader.py visual plan/jobs_spec",
          "scenario": "视觉 LLM 返回 10 个错误锚点 scene",
          "assertions": ["summary 仍只生成 2 张正文图", "锚点使用后端选择结果"],
          "expected": "LLM 不能扩张数量或改变位置",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_visual_llm_cannot_expand_scene_count_or_change_anchors -q"
        },
        {
          "id": "UT-F3-003",
          "target": "app/uploader.py::_extract_detailed_visual_blocks",
          "scenario": "详细模式文章包含标题、代码、原图、列表、尾注和三个正文段落",
          "assertions": ["只选择三个正文段落", "生成 1 张题图 + 3 张正文图"],
          "expected": "详细模式按可配图正文段落工作",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_detailed_mode_uses_prose_paragraphs_and_skips_non_prose -q"
        }
      ],
      "integration_cases": [],
      "regression_cases": []
    },
