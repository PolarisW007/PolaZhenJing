    {
      "id": "F1",
      "name": "上传页四档 AI 生图模式",
      "source_refs": ["requirements#A1", "PRD#4.1"],
      "acceptance_ids": ["A1"],
      "risk": "P2",
      "unit_cases": [
        {
          "id": "UT-F1-001",
          "target": "app/templates/upload.html",
          "scenario": "管理员加载上传页",
          "assertions": ["三个表单各渲染四档 radio", "三个表单默认 standard", "页面包含数量和详细上限文案"],
          "expected": "页面 200 且共渲染 12 个 image_generation_mode 输入",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_upload_page_shows_four_image_modes_in_all_three_forms -q"
        }
      ],
      "integration_cases": [
        {
          "id": "IT-F1-001",
          "target": "scripts/upload_edit_playwright_harness.py",
          "scenario": "管理员在真实浏览器选择详细模式并切换到手机视口",
          "assertions": ["详细模式可选择", "手机视口无横向溢出", "桌面和手机截图生成"],
          "expected": "Playwright harness 退出码 0",
          "command": ".venv/bin/python scripts/upload_edit_playwright_harness.py --base-url http://127.0.0.1:5019"
        }
      ],
      "regression_cases": []
    },
    {
