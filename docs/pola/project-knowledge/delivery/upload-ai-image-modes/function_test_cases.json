      "acceptance_ids": ["A2"],
      "risk": "P2",
      "unit_cases": [
        {
          "id": "UT-F2-001",
          "target": "app/uploader.py::_parse_image_generation_mode",
          "scenario": "接收四个合法值、非法值和空值",
          "assertions": ["合法值原样返回", "非法/空值返回 standard"],
          "expected": "枚举白名单和旧 draft 默认行为稳定",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_parse_image_generation_mode_uses_safe_default -q"
        },
        {
          "id": "UT-F2-002",
          "target": "app/uploader.py upload/draft/generate",
          "scenario": "提交 detailed 并进入生成路由",
          "assertions": ["draft 保存 detailed", "generate payload 传递 summary 样例"],
          "expected": "模式跨越风格选择页不丢失",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_upload_draft_persists_image_generation_mode tests/test_upload_image_modes.py::test_generate_route_passes_image_mode_from_draft -q"
        }
      ],
      "integration_cases": [],
      "regression_cases": []
    },
    {
