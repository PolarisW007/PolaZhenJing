          "assertions": ["只选择 12 段", "选择覆盖文章首尾", "锚点不重复"],
          "expected": "详细模式数量有界且覆盖全文",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_detailed_mode_is_capped_and_spread_across_article -q"
        },
        {
          "id": "UT-F4-002",
          "target": "app/uploader.py image batch deadline",
          "scenario": "整批时间预算已经耗尽",
          "assertions": ["不再发起新的 T2I 请求", "返回已有安全结果"],
          "expected": "deadline 阻止后续调用且不抛异常",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_image_batch_budget_stops_before_new_api_calls -q"
        },
        {
          "id": "UT-F4-003",
          "target": "app/uploader.py image byte limits",
          "scenario": "下一张图片会让批次超过 64MB 等价测试上限",
          "assertions": ["停止写入超限图片", "保留已完成图片"],
          "expected": "批次容量有界并可降级",
          "command": ".venv/bin/python -m pytest tests/test_upload_image_modes.py::test_image_batch_byte_budget_stops_before_writing_oversized_batch -q"
        }
      ],
