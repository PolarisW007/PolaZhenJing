713b19b39b","name":"Zhen Zhang","hidden":false},{"_id":"67720df28e0ed7713b19b39c","name":"Zhenda Xie","hidden":false},{"_id":"67720df28e0ed7713b19b39d","name":"Zhengyan Zhang","hidden":false},{"_id":"67720df28e0ed7713b19b39e","name":"Zhewen Hao","hidden":false},{"_id":"67720df28e0ed7713b19b39f","name":"Zhibin Gou","hidden":false},{"_id":"67720df28e0ed7713b19b3a0","name":"Zhicheng Ma","hidden":false},{"_id":"67720df28e0ed7713b19b3a1","name":"Zhigang Yan","hidden":false},{"_id":"67720df28e0ed7713b19b3a2","user":{"_id":"65db64f8b62d242ed8711701","avatarUrl":"/avatars/753e9f980eb6786c6b53b2f1becbf745.svg","isPro":false,"fullname":"Zhihong Shao","user":"ZhihongShao","type":"user","name":"ZhihongShao"},"name":"Zhihong Shao","status":"claimed_verified","statusLastChangedAt":"2025-01-26T11:38:44.492Z","hidden":false},{"_id":"67720df28e0ed7713b19b3a3","name":"Zhipeng Xu","hidden":false},{"_id":"67720df28e0ed7713b19b3a4","name":"Zhiyu Wu","hidden":false},{"_id":"67720df28e0ed7713b19b3a5","name":"Zhongyu Zhang","hidden":false},{"_id":"67720df28e0ed7713b19b3a6","name":"Zhuoshu Li","hidden":false},{"_id":"67720df28e0ed7713b19b3a7","name":"Zihui Gu","hidden":false},{"_id":"67720df28e0ed7713b19b3a8","name":"Zijia Zhu","hidden":false},{"_id":"67720df28e0ed7713b19b3a9","user":{"_id":"6468c76bff18750165a64df3","avatarUrl":"https://cdn-avatars.huggingface.co/v1/production/uploads/6468c76bff18750165a64df3/dHhE62SHOSJZjyU60vgh7.jpeg","isPro":true,"fullname":"Zijun Liu","user":"BBQGOD","type":"user","name":"BBQGOD"},"name":"Zijun Liu","status":"claimed_verified","statusLastChangedAt":"2024-12-30T19:30:13.962Z","hidden":false},{"_id":"67720df28e0ed7713b19b3aa","name":"Zilin Li","hidden":false},{"_id":"67720df28e0ed7713b19b3ab","name":"Ziwei Xie","hidden":false},{"_id":"67720df28e0ed7713b19b3ac","name":"Ziyang Song","hidden":false},{"_id":"67720df28e0ed7713b19b3ad","name":"Ziyi Gao","hidden":false},{"_id":"67720df28e0ed7713b19b3ae","name":"Zizheng Pan","hidden":false}],"publishedAt":"2024-12-27T04:03:16.000Z","title":"DeepSeek-V3 Technical Report","summary":"We present DeepSeek-V3, a strong Mixture-of-Experts (MoE) language model with\n671B total parameters with 37B activated for each token. To achieve efficient\ninference and cost-effective training, DeepSeek-V3 adopts Multi-head Latent\nAttention (MLA) and DeepSeekMoE architectures, which were thoroughly validated\nin DeepSeek-V2. Furthermore, DeepSeek-V3 pioneers an auxiliary-loss-free\nstrategy for load balancing and sets a multi-token prediction training\nobjective for stronger performance. We pre-train DeepSeek-V3 on 14.8 trillion\ndiverse and high-quality tokens, followed by Supervised Fine-Tuning and\nReinforcement Learning stages to fully harness its capabilities. Comprehensive\nevaluations reveal that DeepSeek-V3 outperforms other open-source models and\nachieves performance comparable to leading closed-source models. Despite its\nexcellent performance, DeepSeek-V3 requires only 2.788M H800 GPU hours for its\nfull training. In addition, its training process is remarkably stable.\nThroughout the entire training process, we did not experience any irrecoverable\nloss spikes or perform any rollbacks. The model checkpoints are available at\nhttps://github.com/deepseek-ai/DeepSeek-V3.","upvotes":85,"discussionId":"67720df38e0ed7713b19b3ee","githubRepo":"https://github.com/deepseek-ai/deepseek-v3","githubRepoAddedBy":"auto","ai_summary":"DeepSeek-V3 is a parameter-efficient Mixture-of-Experts language model using MLA and DeepSeekMoE architectures, achieving high performance with efficient training and minimal computational cost.","ai_keywords":["Mixture-of-Experts (MoE)","Multi-head Latent Attention (MLA)","DeepSeekMoE","auxiliary-loss-free strategy","multi-token prediction","Supervised Fine-Tuning","Reinforcement Learning"],"githubStars":103422,"organization":{"_id":"652faff917096ceb6bf53f3f","name":"deepseek-ai","fullname":"DeepSeek","avatar":"https://cdn-avatars.huggingface.co/v1/production/uploads/6538815d1bdb3c40db94fbfa/xMBly9PUMphrFVMxLX4kq.png"}}
